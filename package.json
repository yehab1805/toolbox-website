{
  "name": "toolbox-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "preview": "next build && next start",
    "deploy": "vercel --prod",
    "analyze": "ANALYZE=true npm run build",
    "lighthouse": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html",
    "perf": "npm run build && npm run start & sleep 5 && npm run lighthouse",
    "seo:generate": "node scripts/generate-tool-metadata.js",
    "seo:update": "node scripts/update-tool-pages.js",
    "seo:og-image": "node scripts/create-og-image.js",
    "seo:check": "npm run build && npm run lighthouse"
